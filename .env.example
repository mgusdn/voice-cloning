# Copy to .env at the repository root. Existing environment variables take priority.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# GPT-SoVITS api_v2.py server. The reference path is an absolute path ON THE SERVER.
TTS_SERVER_URL=http://127.0.0.1:9880
TTS_REF_AUDIO_PATH=
# Exact transcript of the reference audio; quote values containing # or spaces.
TTS_REF_TEXT=""
TTS_LANGUAGE=ko

# Only needed for diarization: accept the pyannote model access conditions first.
HF_TOKEN=
